# Backend
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sipu

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Orígenes permitidos por CORS, separados por comas (vacío = cualquiera)
CORS_ORIGIN=

# URL pública del frontend (enlaces de los correos)
APP_URL=http://localhost:5173

# Envío de correos con Resend (sin clave, en desarrollo el enlace se muestra en consola)
RESEND_API_KEY=
MAIL_FROM=SIPU <onboarding@resend.dev>

# Base para npm test (opcional; por defecto <DATABASE_URL>_test)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sipu_test
