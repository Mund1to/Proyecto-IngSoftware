# Backend
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sipu

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Orígenes permitidos por CORS, separados por comas (vacío = cualquiera)
CORS_ORIGIN=

# Base para npm test (opcional; por defecto <DATABASE_URL>_test)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sipu_test
